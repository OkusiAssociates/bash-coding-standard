#!/usr/bin/env bash
# {{DESCRIPTION}}
# This is a sourceable library script

# --- Execution guard ---
# A pure library is sourced, never run.
[[ ${BASH_SOURCE[0]} != "$0" ]] || {
  >&2 echo "Error: ${0@Q} must be sourced"
  exit 1
}

# --- Already-sourced fence ---
[[ ! -v {{NAME}}_VERSION ]] || return 0

# --- Library metadata ---
# Assign, check, then mark readonly. `declare -r x=$(cmd)` returns declare's
# own status, so a failed cmd leaves x readonly-EMPTY in the caller's shell
# and the fence above would then block any re-source from repairing it.
# VERSION is set last, so a failed load leaves the fence open for a retry.
declare -- {{NAME}}_PATH=''
{{NAME}}_PATH=$(realpath -- "${BASH_SOURCE[0]}") \
  || { >&2 echo '{{NAME}}: cannot resolve library path'; return 1; }
declare -rx {{NAME}}_PATH
declare -rx {{NAME}}_DIR=${{{NAME}}_PATH%/*}
declare -rx {{NAME}}_VERSION='{{VERSION}}'

# Messaging functions (library prefix)
{{NAME}}_msg()   { >&2 printf '{{NAME}}: %s\n' "$@"; }
declare -fx {{NAME}}_msg

{{NAME}}_error() { >&2 printf '{{NAME}}: ✗ %s\n' "$@"; }
declare -fx {{NAME}}_error

# Example library function
{{NAME}}_hello() {
  local -- name=${1:-World}
  echo "Hello, $name from {{NAME}} library!"
}
declare -fx {{NAME}}_hello

# Library initialization -- the caller invokes this. A library defines
# functions and has no side effects on source (BCS0407).
{{NAME}}_init() {
  # TODO: Add initialization logic
  return 0
}
declare -fx {{NAME}}_init
#fin
